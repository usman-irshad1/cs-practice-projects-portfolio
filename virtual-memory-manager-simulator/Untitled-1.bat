

COUNT equ 0x120

CLRF T3CON
MOVLW b'00000010'
MOVWF CCP1CON
CLRF TRISD
MOVLW b'00000110'
MOVWF T1CON
CLRF COUNT
BCF TRISC, CCP1
BSF TRISC , T3K1

MOVLW 0x3
MOVWF CCPR1H
MOVLW 0xE8
MOVWF CCPR1L

AGAIN1:
CLRF TMR1L
CLRF TMR1H
BCF PIR1, CCP1IF
BSF T1CON, TMR1ON

again:
BTFSS PIRI, CCP1IF
goto again
BCF T1CON, TMR1ON
INCF COUNT, F
MOVFF COUNT, PORTD
goto AGAIN1

